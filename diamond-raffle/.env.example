# Database (docker-compose uses db:5432 internally)
DATABASE_URL=postgresql+psycopg2://raffle:raffle@localhost:5432/raffle

# Application
BASE_URL=https://raffle.apexcore.group
SESSION_SECRET=your-secret-key-here-32-bytes-minimum

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin User (auto-generated on first startup if not set; generated password logged)
ADMIN_EMAIL=admin@apexcore.group
ADMIN_PASSWORD=

# Raffle Configuration
RAFFLE_TITLE=1,5 Karat Diamant Raffle
DIAMOND_CARAT=1.5
RAFFLE_PRICE_CENTS=1000
RAFFLE_CURRENCY=eur
RAFFLE_TOTAL_TICKETS=750
RAFFLE_DURATION_DAYS=30
MAX_TICKETS_PER_ORDER=20
RESERVATION_MINUTES=30

# Legal / Organizer Information (must be updated before going live)
ORGANIZER_NAME=[PLATZHALTER: Firmenname GmbH/d.o.o.]
ORGANIZER_ADDRESS=[PLATZHALTER: Straße, PLZ Ort, Land]
ORGANIZER_EMAIL=[PLATZHALTER: kontakt@apexcore.group]
